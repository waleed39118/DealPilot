# ============================================================
# DealPilot backend — environment template
# Copy to backend/.env and fill in values. NEVER commit .env.
# Lists are comma-separated. Phone numbers use E.164 (+9665XXXXXXXX).
# Keep comments on their own line: text after a value is read as part of it.
# ============================================================

# ── Runtime ─────────────────────────────────────────────────
# sandbox = outbound only to the allow-lists below (default, safe)
# live    = real customers; refuses to start unless all compliance settings are set
APP_MODE=sandbox
# development | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Public HTTPS URL for webhook callbacks, e.g. https://api.example.com
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost

# ── Database / Realtime (use a separate project per environment) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Encryption at rest (REQUIRED) ───────────────────────────
# Generate: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_VERSION=1
# Rotation only: retired keys still needed to decrypt, e.g. 1:<base64>,2:<base64>
MASTER_ENCRYPTION_PREVIOUS_KEYS=

# ── Language model providers ────────────────────────────────
LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_PRIMARY_FAST_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── Sender identity & legal footer ──────────────────────────
COMPANY_LEGAL_NAME=
COMPANY_POSTAL_ADDRESS=
PRIVACY_POLICY_URL=

# ── Email ───────────────────────────────────────────────────
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ── Twilio (voice + WhatsApp) ───────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
TWILIO_WHATSAPP_SENDER=

# ── Fax ─────────────────────────────────────────────────────
FAX_PROVIDER=
FAX_API_KEY=

# ── Licensed prospect-data providers ────────────────────────
APOLLO_API_KEY=
PDL_API_KEY=
HUNTER_API_KEY=

# ── Push notifications ──────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Sandbox allow-lists (your own test inbox / phone) ───────
SANDBOX_ALLOWED_EMAILS=
SANDBOX_ALLOWED_PHONES=

# ── Self-healing ────────────────────────────────────────────
WATCHDOG_INTERVAL_SECONDS=60
